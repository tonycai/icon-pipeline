# icons/icon.env — settings for scripts/build-icons.sh (shell syntax, sourced by the script)
# Command-line flags override these values. Full reference: bash scripts/build-icons.sh --help

# What to build: any of  web og ios android
TARGETS="web og"

# ---- Sources (only SRC is required; the others are used when the file exists)
SRC="icons/source.svg"               # master artwork, square viewBox (e.g. 0 0 512 512)
SRC_SMALL="icons/source-small.svg"   # simplified artwork for <= SMALL_MAX px (favicons)
SRC_MONO="icons/source-mono.svg"     # one-colour silhouette: Android themed/notification, iOS tinted
SRC_DARK="icons/source-dark.svg"     # artwork variant for the iOS dark icon
SMALL_MAX="48"

# ---- Brand
NAME="My App"
SHORT_NAME="My App"
THEME_COLOR="#ffffff"                # browser UI tint, OG accent bar
BG_COLOR="#ffffff"                   # fill behind opaque icons (apple-touch, maskable, iOS, Android)

# ---- Artwork scale inside opaque icons (1.0 = edge to edge)
#   transparent glyph/logo mark     -> 0.8 / 0.7 / 0.54 (defaults)
#   artwork already has its own bg  -> APPLE_SCALE=1.0 MASKABLE_SCALE=1.0 (keep key shapes in the central 80%)
APPLE_SCALE="0.8"                    # apple-touch-icon, iOS app icon, Play Store icon
MASKABLE_SCALE="0.7"                 # PWA maskable
ANDROID_FG_SCALE="0.54"              # adaptive foreground on the 108dp canvas (safe zone ≈ 0.61)

# ---- web
OUT="public"                         # static web root
ICON_DIR="icons"                     # PNGs go to $OUT/$ICON_DIR/
PUBLIC_PATH="/"                      # URL prefix where OUT is served
MANIFEST="manifest.webmanifest"      # created if missing; if present only "icons" is replaced (needs jq)
PNG_SIZES="16 32 48 64 128 192 256 512 1024"
CACHE_BUST="1"                       # add ?v=<hash> to <link> URLs so browsers refresh cached favicons

# ---- og (social share image, 1200x630)
SITE_URL=""                          # e.g. https://example.com — og:image must be absolute
OG_TITLE=""                          # default: NAME. Use \n for line breaks: "第一行\n第二行"
OG_SUBTITLE=""
OG_BG_COLOR=""                       # default: BG_COLOR
OG_TEXT_COLOR="#111827"
OG_MUTED_COLOR="#4b5563"
OG_ACCENT_COLOR=""                   # default: THEME_COLOR
OG_FONT="Noto Sans CJK SC, Noto Sans CJK JP, Source Han Sans SC, PingFang SC, Hiragino Sans, sans-serif"
OG_FONT_FILE=""                      # e.g. icons/fonts/NotoSansCJKjp-Bold.otf (OFL) — reproducible on every machine
OG_TITLE_SIZE="64"
OG_TEMPLATE="icons/og-template.svg"  # used if it exists; start from: bash scripts/build-icons.sh --print-og-template

# ---- ios / android (empty dir = write to NATIVE_OUT staging instead of the real project)
NATIVE_OUT="icons/native"
IOS_ICONSET_DIR=""                   # e.g. ios/App/App/Assets.xcassets/AppIcon.appiconset
IOS_DARK_BG="#000000"
IOS_APPEARANCES="1"                  # 1 = Any + Dark + Tinted (Xcode 16+); 0 = single icon
ANDROID_RES_DIR=""                   # e.g. android/app/src/main/res
ANDROID_MONOCHROME="1"               # themed icon layer (Android 13+, needs compileSdk >= 33)
ANDROID_NOTIFICATION="1"             # drawable-*/ic_stat_notification.png
